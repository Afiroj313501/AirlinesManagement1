<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.airlinesmanagement1.DashboardController">

   <!-- Professional Sidebar -->
   <left>
      <VBox prefWidth="250.0" style="-fx-background-color: #2c3e50;">
         <children>
            <!-- Logo Section -->
            <VBox alignment="CENTER" prefHeight="100.0" style="-fx-padding: 20px; -fx-background-color: #34495e;">
               <children>
                  <Label text="✈️" style="-fx-font-size: 32px;" />
                  <Label text="AIRLINES" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                  <Label text="MANAGEMENT" style="-fx-font-size: 10px; -fx-text-fill: #bdc3c7;" />
               </children>
            </VBox>
            
            <!-- Navigation Menu -->
            <VBox spacing="8.0" alignment="TOP_CENTER" style="-fx-padding: 20px 15px;">
               <children>
                  <Button onAction="#goToFlightInfo" text="📊 Dashboard" style="-fx-background-color: linear-gradient(to right, #00BCF2, #3498db); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
                  <Button onAction="#goToManageBookings" text="✈️ Book Flight" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
                  <Button onAction="#goToManageFlight" text="🔧 Manage Flight" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
                  <Button onAction="#goToBookingHistory" text="🎫 My Tickets" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
                  <Button onAction="#goToSupport" text="💬 Support" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
                  <Button onAction="#goToSettings" text="⭐ Rating" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: #ffffff; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
               </children>
            </VBox>
            
            <!-- Logout Section -->
            <VBox alignment="CENTER" style="-fx-padding: 20px;">
               <VBox.vgrow>
                  <Priority fx:constant="ALWAYS"/>
               </VBox.vgrow>
               <children>
                  <Button onAction="#handleLogout" text="🚪 Logout" style="-fx-background-color: linear-gradient(to right, #e74c3c, #c0392b); -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 12px 20px; -fx-min-width: 200px; -fx-cursor: hand;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <!-- Main Content Area -->
   <center>
      <VBox spacing="0.0" style="-fx-background-color: #ecf0f1;">
         <children>
            <!-- Header Section -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #ffffff; -fx-padding: 15px 25px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);">
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="3.0">
                     <children>
                        <Label fx:id="welcomeLabel" text="Welcome back!" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label text="Manage your flights and bookings efficiently" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <HBox.hgrow>
                        <Priority fx:constant="ALWAYS"/>
                     </HBox.hgrow>
                     <children>
                        <Button onAction="#refreshStats" text="🔄 Refresh" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-padding: 8px 15px;" />
                        <Label text="🕐 " style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                        <Label fx:id="timeLabel" text="Current Time" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            
            <!-- Dashboard Content -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
               <content>
                  <VBox spacing="25.0" alignment="TOP_CENTER" style="-fx-padding: 25px;">
                     <children>
                        <!-- Quick Stats Cards -->
                        <HBox spacing="20.0" alignment="CENTER">
                           <children>
                              <VBox alignment="CENTER" prefWidth="200.0" prefHeight="120.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15px; -fx-padding: 25px;">
                                 <children>
                                    <Label text="✈️" style="-fx-font-size: 32px; -fx-text-fill: #3498db;" />
                                    <Label text="Available Flights" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    <Label fx:id="flightCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefWidth="200.0" prefHeight="120.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15px; -fx-padding: 25px;">
                                 <children>
                                    <Label text="🎫" style="-fx-font-size: 32px; -fx-text-fill: #9b59b6;" />
                                    <Label text="My Bookings" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    <Label fx:id="bookingCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefWidth="200.0" prefHeight="120.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15px; -fx-padding: 25px;">
                                 <children>
                                    <Label text="✅" style="-fx-font-size: 32px; -fx-text-fill: #27ae60;" />
                                    <Label text="Completed Flights" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    <Label fx:id="completedFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        
                        <!-- Flight Status Cards -->
                        <HBox spacing="20.0" alignment="CENTER">
                           <children>
                              <VBox alignment="CENTER" prefWidth="200.0" prefHeight="120.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15px; -fx-padding: 25px;">
                                 <children>
                                    <Label text="🔄" style="-fx-font-size: 32px; -fx-text-fill: #3498db;" />
                                    <Label text="Upcoming Flights" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    <Label fx:id="upcomingFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefWidth="200.0" prefHeight="120.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15px; -fx-padding: 25px;">
                                 <children>
                                    <Label text="⏳" style="-fx-font-size: 32px; -fx-text-fill: #f39c12;" />
                                    <Label text="Pending Flights" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    <Label fx:id="pendingFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefWidth="200.0" prefHeight="120.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15px; -fx-padding: 25px;">
                                 <children>
                                    <Label text="❌" style="-fx-font-size: 32px; -fx-text-fill: #e74c3c;" />
                                    <Label text="Cancelled Flights" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                    <Label fx:id="cancelledFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        
                        <!-- Flight Information Section -->
                        <VBox alignment="CENTER" spacing="15.0">
                           <children>
                              <Label text="Flight Information" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                              <HBox spacing="20.0" alignment="CENTER">
                                 <children>
                                    <VBox alignment="CENTER" prefWidth="250.0" prefHeight="150.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10px; -fx-padding: 15px;">
                                       <children>
                                          <Label text="📅" style="-fx-font-size: 32px; -fx-text-fill: #3498db;" />
                                          <Label text="Next Flight" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                          <Label fx:id="nextFlightLabel" text="No upcoming flights" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" prefWidth="250.0" prefHeight="150.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10px; -fx-padding: 15px;">
                                       <children>
                                          <Label text="🎯" style="-fx-font-size: 32px; -fx-text-fill: #9b59b6;" />
                                          <Label text="Total Flights" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                          <Label fx:id="totalFlightsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" prefWidth="250.0" prefHeight="150.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10px; -fx-padding: 15px;">
                                       <children>
                                          <Label text="💰" style="-fx-font-size: 32px; -fx-text-fill: #f39c12;" />
                                          <Label text="Total Spent" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                                          <Label fx:id="totalSpentLabel" text="BDT 0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f39c12;" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <!-- Quick Actions -->
                        <VBox alignment="CENTER" spacing="15.0">
                           <children>
                              <Label text="Quick Actions" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                              <HBox spacing="15.0" alignment="CENTER">
                                 <children>
                                    <Button onAction="#goToManageBookings" text="Book New Flight" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-padding: 10px 20px;" />
                                    <Button onAction="#goToBookingHistory" text="View Tickets" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-padding: 10px 20px;" />
                                    <Button onAction="#goToSupport" text="Get Support" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-padding: 10px 20px;" />
                                    <Button onAction="#goToSettings" text="Rate Service" style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-padding: 10px 20px;" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <!-- Welcome Section -->
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label text="✈️" style="-fx-font-size: 60px; -fx-text-fill: #3498db;" />
                              <Label text="Welcome to Airlines Management" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                              <Label text="Your journey starts here" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>

   <!-- Professional Footer -->
   <bottom>
      <HBox alignment="CENTER" prefHeight="50.0" style="-fx-background-color: #2c3e50;">
         <children>
            <Label text="✈️ Airlines Management System © 2025" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
            <Label text="|" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
            <Label text="Powered by Team Abdullah" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
            <Label text="|" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
            <Label text="Version 2.0" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
         </children>
      </HBox>
   </bottom>
</BorderPane>