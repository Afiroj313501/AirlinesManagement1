<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="600" prefWidth="800" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.airlinesmanagement1.DashboardController">
   <!-- Sidebar with navigation buttons -->
   <left>
      <AnchorPane prefWidth="120" style="-fx-background-color: #465AA6;">
         <children>
            <Button layoutY="48.0" onAction="#goToFlightInfo" styleClass="sidebar-button" text="Dashboard" />
            <Button layoutY="100.0" onAction="#goToManageBookings" styleClass="sidebar-button" text="Book Flight" />
            <Button layoutY="148.0" onAction="#goToBookingHistory" styleClass="sidebar-button" text="Manage Flight" />
            <Button layoutY="199.0" onAction="#goToSupport" styleClass="sidebar-button" text="Ticket" />
            <Button layoutY="245.0" onAction="#goToSettings" styleClass="sidebar-button" text="Reports" />
            <Button layoutY="300.0" onAction="#handleLogout" styleClass="sidebar-button" text="Logout" />
         </children>
      </AnchorPane>
   </left>

   <!-- Main content area with welcome label and image -->
   <center>
      <AnchorPane>
         <children>
            <Label fx:id="welcomeLabel" layoutX="100" layoutY="20" styleClass="dashboard-title" text="Welcome to the Dashboard!" />
            <ImageView fx:id="dashboardImageView" fitHeight="400" fitWidth="500" layoutX="100" layoutY="80" preserveRatio="true">
               <image>
                  <Image url="@../Images/Dash.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>
   </center>

   <!-- Footer with branding -->
   <bottom>
      <HBox fx:id="footerBox" alignment="CENTER" prefHeight="50" styleClass="footer">
         <children>
            <Label styleClass="footer-label" text="✈️ Airlines Management System © 2025  |  Powered by Team Abdullah" />
         </children>
      </HBox>
   </bottom>
</BorderPane>