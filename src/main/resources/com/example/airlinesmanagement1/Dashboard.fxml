<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.airlinesmanagement1.DashboardController">

   <!-- Professional Sidebar -->
   <left>
      <VBox prefWidth="280.0" styleClass="professional-sidebar">
         <children>
            <!-- Logo Section -->
            <VBox styleClass="sidebar-header" alignment="CENTER" prefHeight="120.0">
               <children>
                  <Label text="✈️" style="-fx-font-size: 40px; -fx-text-fill: white;" />
                  <Label text="AIRLINES" styleClass="sidebar-brand-text" />
                  <Label text="MANAGEMENT" styleClass="sidebar-brand-subtext" />
               </children>
            </VBox>
            
            <!-- Navigation Menu -->
            <VBox styleClass="sidebar-menu" spacing="8.0" alignment="TOP_CENTER">
               <children>
                  <Button onAction="#goToFlightInfo" styleClass="nav-button nav-button-active" text="📊 Dashboard" />
                  <Button onAction="#goToManageBookings" styleClass="nav-button" text="✈️ Book Flight" />
                  <Button onAction="#goToManageFlight" styleClass="nav-button" text="🔧 Manage Flight" />
                  <Button onAction="#goToBookingHistory" styleClass="nav-button" text="🎫 My Tickets" />
                  <Button onAction="#goToSupport" styleClass="nav-button" text="💬 Support" />
                  <Button onAction="#goToSettings" styleClass="nav-button" text="⭐ Rating" />
               </children>
            </VBox>
            
            <!-- Logout Section -->
            <VBox styleClass="sidebar-footer" alignment="CENTER" VBox.vgrow="ALWAYS">
               <children>
                  <Button onAction="#handleLogout" styleClass="logout-button" text="🚪 Logout" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <!-- Main Content Area -->
   <center>
      <VBox styleClass="main-content" spacing="0.0">
         <children>
            <!-- Header Section -->
            <HBox styleClass="dashboard-header" alignment="CENTER_LEFT" prefHeight="80.0">
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label fx:id="welcomeLabel" styleClass="welcome-title" text="Welcome back!" />
                        <Label styleClass="welcome-subtitle" text="Manage your flights and bookings efficiently" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="current-time" text="🕐 " />
                        <Label fx:id="timeLabel" styleClass="current-time" text="Current Time" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            
            <!-- Dashboard Content -->
            <ScrollPane styleClass="dashboard-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
               <content>
                  <VBox styleClass="dashboard-content" spacing="30.0" alignment="TOP_CENTER">
                     <children>
                        <!-- Quick Stats Cards -->
                        <HBox styleClass="stats-container" spacing="20.0" alignment="CENTER">
                           <children>
                              <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200.0" prefHeight="120.0">
                                 <children>
                                    <Label text="✈️" styleClass="stat-icon" />
                                    <Label text="Available Flights" styleClass="stat-label" />
                                    <Label fx:id="flightCountLabel" text="0" styleClass="stat-value" />
                                 </children>
                              </VBox>
                              <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200.0" prefHeight="120.0">
                                 <children>
                                    <Label text="🎫" styleClass="stat-icon" />
                                    <Label text="My Bookings" styleClass="stat-label" />
                                    <Label fx:id="bookingCountLabel" text="0" styleClass="stat-value" />
                                 </children>
                              </VBox>
                              <VBox styleClass="stat-card" alignment="CENTER" prefWidth="200.0" prefHeight="120.0">
                                 <children>
                                    <Label text="⭐" styleClass="stat-icon" />
                                    <Label text="My Ratings" styleClass="stat-label" />
                                    <Label fx:id="ratingCountLabel" text="0" styleClass="stat-value" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        
                        <!-- Main Dashboard Content -->
                        <VBox styleClass="dashboard-image-container" alignment="CENTER">
                           <children>
                              <Label text="✈️" style="-fx-font-size: 120px; -fx-text-fill: #00BCF2;" />
                              <Label text="Welcome to Airlines Management" styleClass="dashboard-image-caption" />
                              <Label text="Your journey starts here" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
                           </children>
                        </VBox>
                        
                        <!-- Quick Actions -->
                        <VBox styleClass="quick-actions-container" alignment="CENTER" spacing="15.0">
                           <children>
                              <Label text="Quick Actions" styleClass="section-title" />
                              <HBox styleClass="quick-actions-grid" spacing="15.0" alignment="CENTER">
                                 <children>
                                    <Button onAction="#goToManageBookings" styleClass="quick-action-button" text="Book New Flight" />
                                    <Button onAction="#goToBookingHistory" styleClass="quick-action-button" text="View Tickets" />
                                    <Button onAction="#goToSupport" styleClass="quick-action-button" text="Get Support" />
                                    <Button onAction="#goToSettings" styleClass="quick-action-button" text="Rate Service" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>

   <!-- Professional Footer -->
   <bottom>
      <HBox styleClass="professional-footer" alignment="CENTER" prefHeight="60.0">
         <children>
            <Label styleClass="footer-text" text="✈️ Airlines Management System © 2025" />
            <Label styleClass="footer-divider" text="|" />
            <Label styleClass="footer-text" text="Powered by Team Abdullah" />
            <Label styleClass="footer-divider" text="|" />
            <Label styleClass="footer-text" text="Version 2.0" />
         </children>
      </HBox>
   </bottom>
</BorderPane>