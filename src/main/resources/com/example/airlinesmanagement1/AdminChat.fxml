<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinesmanagement1.AdminChatController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 15px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 2, 0, 0, 1);">
            <children>
                <Label text="💬 Admin Chat Support" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label text="Manage user support conversations and send messages" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
            </children>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 20px;">
            <children>
                <!-- Chat Area -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-padding: 15px;">
                    <children>
                        <Label text="📨 Chat Messages" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <TextArea fx:id="chatArea" editable="false" prefHeight="400" wrapText="true" 
                                 style="-fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-background-color: #f8f9fa;" />
                        
                        <!-- Message Input Section -->
                        <VBox spacing="8">
                            <children>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Recipient:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
                                        <TextField fx:id="recipientField" promptText="Leave empty for broadcast" prefWidth="200" />
                                    </children>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER">
                                    <children>
                                        <TextField fx:id="messageField" promptText="Type your message..." HBox.hgrow="ALWAYS" />
                                        <Button fx:id="sendButton" text="📤 Send" onAction="#sendMessage" 
                                               style="-fx-background-color: #3498db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 8px 15px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- User List -->
                <VBox spacing="10" prefWidth="250" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-padding: 15px;">
                    <children>
                        <Label text="👥 Connected Users" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <ListView fx:id="userList" prefHeight="400" />
                        <Label text="Click a user to send private message" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-padding: 10px;">
            <children>
                <Label text="💬 Admin Chat System - Connected to Support Server" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12px;" />
            </children>
        </HBox>
    </bottom>

</BorderPane>