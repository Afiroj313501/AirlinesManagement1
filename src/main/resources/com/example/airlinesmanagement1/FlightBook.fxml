<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.airlinesmanagement1.FlightBookController"
            prefWidth="400" prefHeight="300" style="-fx-background-color: #ffffff;"  stylesheets="@style.css" >

    <VBox spacing="15" alignment="CENTER" layoutX="50" layoutY="30" prefWidth="300">
        <Label text="✈️ Book Your Flight" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextField fx:id="fromField" promptText="From" />
        <TextField fx:id="toField" promptText="To" />
        <DatePicker fx:id="flightDatePicker" promptText="Select Date" />

        <Button text="Search" onAction="#handleSearchFlight" />
    </VBox>
</AnchorPane>
