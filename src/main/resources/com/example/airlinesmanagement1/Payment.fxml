<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.airlinesmanagement1.PaymentController"
            prefWidth="700" prefHeight="500" 
            styleClass="payment-container"
            stylesheets="@style.css">

    <VBox spacing="10" alignment="TOP_CENTER" layoutX="30" layoutY="20" prefWidth="640">
        
        <!-- Compact Header -->
        <HBox alignment="CENTER" spacing="20" styleClass="payment-card">
            <VBox alignment="CENTER">
                <Label text="💳 Secure Payment" styleClass="payment-title"/>
                <Label fx:id="totalAmountLabel" text="Total Amount: 0 BDT" styleClass="payment-amount"/>
            </VBox>
            
            <!-- Compact Flight Details -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="✈️ Flight Details" styleClass="payment-subtitle"/>
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="2">
                        <Label fx:id="fromLabel" text="From: " styleClass="flight-detail-label"/>
                        <Label fx:id="fromValueLabel" text="" styleClass="flight-detail-value"/>
                    </VBox>
                    <Label text="→" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <VBox alignment="CENTER" spacing="2">
                        <Label fx:id="toLabel" text="To: " styleClass="flight-detail-label"/>
                        <Label fx:id="toValueLabel" text="" styleClass="flight-detail-value"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2">
                        <Label fx:id="dateLabel" text="Date: " styleClass="flight-detail-label"/>
                        <Label fx:id="dateValueLabel" text="" styleClass="flight-detail-value"/>
                    </VBox>
                </HBox>
                <Label fx:id="seatsLabel" text="Selected Seats: " styleClass="flight-detail-label"/>
            </VBox>
        </HBox>

        <!-- Payment Methods and Details Side by Side -->
        <HBox spacing="15" alignment="TOP_CENTER">
            <!-- Payment Methods -->
            <VBox alignment="TOP_CENTER" styleClass="payment-card" prefWidth="300">
                <Label text="🔒 Payment Method" styleClass="payment-title"/>
                
                <VBox spacing="8" style="-fx-padding: 12 0 0 0;">
                    <!-- Mobile Banking -->
                    <TitledPane text="📱 Mobile Banking" expanded="true" styleClass="payment-titled-pane">
                        <VBox spacing="6">
                            <RadioButton fx:id="bkashRadio" text="bKash" userData="bKash" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="rocketRadio" text="Rocket" userData="Rocket" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="nagadRadio" text="Nagad" userData="Nagad" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="upayRadio" text="Upay" userData="Upay" styleClass="payment-radio-button"/>
                        </VBox>
                    </TitledPane>

                    <!-- Bank Cards -->
                    <TitledPane text="💳 Credit/Debit Cards" expanded="false" styleClass="payment-titled-pane">
                        <VBox spacing="6">
                            <RadioButton fx:id="visaRadio" text="Visa Card" userData="Visa" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="mastercardRadio" text="Mastercard" userData="Mastercard" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="amexRadio" text="American Express" userData="Amex" styleClass="payment-radio-button"/>
                        </VBox>
                    </TitledPane>

                    <!-- Internet Banking -->
                    <TitledPane text="🏦 Internet Banking" expanded="false" styleClass="payment-titled-pane">
                        <VBox spacing="6">
                            <RadioButton fx:id="easternBankRadio" text="Eastern Bank" userData="Eastern Bank" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="bracBankRadio" text="BRAC Bank" userData="BRAC Bank" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="cityBankRadio" text="City Bank" userData="City Bank" styleClass="payment-radio-button"/>
                            <RadioButton fx:id="ucbRadio" text="UCB Bank" userData="UCB Bank" styleClass="payment-radio-button"/>
                        </VBox>
                    </TitledPane>
                </VBox>
            </VBox>

            <!-- Payment Details -->
            <VBox alignment="TOP_CENTER" styleClass="payment-card" prefWidth="300">
                <Label text="📋 Payment Details" styleClass="payment-title"/>
                
                <VBox spacing="10" style="-fx-padding: 12 0 0 0;">
                    <TextField fx:id="cardNumberField" promptText="Card Number" styleClass="payment-text-field"/>
                    <HBox spacing="8">
                        <TextField fx:id="expiryField" promptText="MM/YY" styleClass="payment-text-field" prefWidth="100"/>
                        <TextField fx:id="cvvField" promptText="CVV" styleClass="payment-text-field" prefWidth="70"/>
                    </HBox>
                    <TextField fx:id="cardholderField" promptText="Cardholder Name" styleClass="payment-text-field"/>
                    <TextField fx:id="phoneField" promptText="Phone Number (for mobile banking)" styleClass="payment-text-field"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="payButton" text="💳 Pay Now" onAction="#handlePayment" styleClass="payment-button"/>
            <Button fx:id="cancelButton" text="❌ Cancel" onAction="#handleCancel" styleClass="payment-cancel-button"/>
        </HBox>

        <!-- Security Notice -->
        <Label text="🔒 Your payment information is encrypted and secure" styleClass="payment-security-notice"/>
    </VBox>

</AnchorPane> 