<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinesmanagement1.TicketController"
            prefWidth="800" prefHeight="600">

    <TableView fx:id="ticketTable"
               layoutX="50" layoutY="50"
               prefWidth="700" prefHeight="400">
        <columns>
            <TableColumn fx:id="flightIdCol" text="Flight ID" prefWidth="100"/>
            <TableColumn fx:id="seatCol" text="Seat Number" prefWidth="150"/>
            <TableColumn fx:id="dateCol" text="Booking Date" prefWidth="200"/>
            <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Buttons -->
    <Button layoutX="50" layoutY="460" text="Download PDF" onAction="#downloadPdfTicket" />
    <Button layoutX="150" layoutY="460" text="Back" onAction="#goBack" />

</AnchorPane>